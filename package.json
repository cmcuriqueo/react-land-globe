{
  "name": "react-land-globe",
  "version": "0.1.0",
  "description": "Globo terráqueo interactivo en canvas para React: continentes punteados, rotación automática, marcadores con glow y arrastre. Cero dependencias, SSR-safe.",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "scripts",
    "data",
    "docs"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "node scripts/dev-server.mjs",
    "generate-land-dots": "node scripts/generate-land-dots.mjs",
    "test": "vitest run",
    "test:e2e": "node test/e2e/run.mjs",
    "test:package": "publint && attw --pack .",
    "test:all": "npm run test && npm run test:e2e && npm run test:package"
  },
  "keywords": [
    "react",
    "globe",
    "canvas",
    "earth",
    "world",
    "map",
    "markers",
    "interactive",
    "dotted-globe",
    "3d"
  ],
  "license": "MIT",
  "peerDependencies": {
    "react": ">=17"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "esbuild": "^0.28.1",
    "jsdom": "^29.1.1",
    "playwright-core": "^1.62.0",
    "publint": "^0.3.22",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "vitest": "^4.1.10"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cmcuriqueo/react-land-globe.git"
  },
  "homepage": "https://github.com/cmcuriqueo/react-land-globe#readme",
  "bugs": {
    "url": "https://github.com/cmcuriqueo/react-land-globe/issues"
  }
}
